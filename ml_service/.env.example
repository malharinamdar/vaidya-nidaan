# Vaidya Nidaan - ML / inference service (Flask) configuration
# Copy to ".env" and fill in. Never commit the real .env.

# Port the Flask service listens on. The frontend expects 5001 by default.
PORT=5001

# --- Trained VGG-19 model -----------------------------------------------------
# Either a local path to the .h5 file...
ALZHEIMER_MODEL_PATH=
# ...or a (private) Hugging Face repo it is downloaded from on first use.
HF_TOKEN=
ALZHEIMER_MODEL_REPO=malharinamdar/alzheimer-prediction-model
ALZHEIMER_MODEL_FILE=alzheimer_model.h5
# The model was trained on raw 0-255 pixels (see research/notebooks/final_alzheimer_model.ipynb).
MODEL_PREPROCESS=raw
GRADCAM_LAYER=block5_conv4

# --- FSL biomarker analysis ---------------------------------------------------
# Auto-detected from ~/fsl, /usr/local/fsl, /opt/fsl when blank. Without FSL the
# biomarker report falls back to image-intensity statistics.
FSLDIR=

# --- GPT-4o assistant + clinical rationale -----------------------------------
# Without a key, an offline rule-based assistant answers instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Auth + CORS --------------------------------------------------------------
# Must equal JWT_SECRET in website/backend/.env. When set, every POST route requires
# the gateway's Bearer token. Leave blank for open local development.
JWT_SECRET=
# Comma-separated allowed origins (blank = any origin, for local dev).
CORS_ORIGINS=http://localhost:5173

# --- Rate limits (requests per caller per window) -----------------------------
RATE_LIMIT_ANALYSIS=60
RATE_LIMIT_DIAGNOSIS=20
RATE_LIMIT_CHAT=60
RATE_LIMIT_WINDOW_S=3600

# --- Optional: PubMed E-utilities etiquette for rebuilding the RAG store ------
NCBI_API_KEY=
NCBI_EMAIL=

# --- Response cache -----------------------------------------------------------
# Redis URL (e.g. a free Upstash database: rediss://default:<token>@<host>:6379).
# Blank = in-process cache per container.
REDIS_URL=
CACHE_TTL_S=86400
