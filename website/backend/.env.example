# Vaidya Nidaan — API gateway (Node/Express) configuration.
# Copy to ".env" and fill in. Never commit the real .env.

PORT=5005

# Secret used to sign login JWTs. Must be long and random, and IDENTICAL to
# JWT_SECRET in ml_service/.env (the ML service verifies the same tokens).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Leave EMPTY for local dev: an in-memory MongoDB starts automatically (not persisted).
MONGO_URI=
MONGO_DB_NAME=vaidya_nidaan

# Comma-separated browser origins allowed to call the API (blank = any, local dev only).
CORS_ORIGINS=http://localhost:5173

# "true" enables POST /api/doctors/demo — the one-click shared demo workspace
# (a demo clinician with fictional patients). Run `npm run init-db` once to seed it.
DEMO_MODE=true
