# Frontend (Vite) configuration. Copy to ".env" to override the local defaults.
# Node/Express API gateway (auth, patients, saved reports):
VITE_API_BASE=http://localhost:5005
# Python ML/inference service (prediction, Grad-CAM++, biomarkers, report, assistant):
VITE_ML_BASE=http://localhost:5001
# In production (Vercel), set these to the deployed URLs, e.g.
#   VITE_API_BASE=https://vaidya-nidaan-api.vercel.app
#   VITE_ML_BASE=https://<modal-user>--vaidya-nidaan-ml-flask-app.modal.run
